# ──────────────────────────────────────────────
# JobHunter — environment variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=sqlite:///./data/jobhunter.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://jobhunter:password@localhost:5432/jobhunter
#
# Connection pool (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ── Security ──────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX
PROFILE_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ── Email (for job alert ingestion via IMAP) ──
ALERT_EMAIL_HOST=imap.gmail.com
ALERT_EMAIL_PORT=993
ALERT_EMAIL_USER=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password     # Gmail app password, not account password
ALERT_EMAIL_FOLDER=INBOX

# ── Notifications ─────────────────────────────
# Email (outbound)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFY_TO_EMAIL=your-email@gmail.com

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI providers (all optional) ───────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=anthropic          # anthropic | openai | none
AI_MODEL=claude-sonnet-4-6     # model string for chosen provider

# ── Scheduler ─────────────────────────────────
SEARCH_INTERVAL_HOURS=4        # How often to run all connectors
SEARCH_INTERVAL_JITTER=600     # Random jitter ±seconds to avoid patterns

# ── Rate limiting ─────────────────────────────
MIN_REQUEST_DELAY_SECONDS=5    # Minimum delay between requests per source
MAX_REQUEST_DELAY_SECONDS=15   # Maximum delay (randomised)

# ── Dashboard ─────────────────────────────────
DASHBOARD_PORT=8501
API_PORT=8000

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/jobhunter.log
